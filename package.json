{
  "name": "outlet-ops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@outlet-ops/web",
    "build": "turbo build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "dbmate --env MIGRATOR_DATABASE_URL --migrations-dir packages/db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --env MIGRATOR_DATABASE_URL --migrations-dir packages/db/migrations --no-dump-schema rollback",
    "db:new": "dbmate --migrations-dir packages/db/migrations new",
    "db:seed": "pnpm --filter @outlet-ops/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "^16.3.6",
    "@types/node": "^22.0.0",
    "dbmate": "^2.36.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
