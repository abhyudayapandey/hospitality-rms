[Unit]
Description=Caddy (TLS termination for Outlet Ops)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
EnvironmentFile=/etc/outlet-ops/caddy.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/caddy run --config /etc/outlet-ops/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/outlet-ops/Caddyfile --adapter caddyfile --force
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
