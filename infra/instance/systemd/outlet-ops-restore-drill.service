[Unit]
Description=Outlet Ops weekly restore check of the newest backup (ADR 171)
After=docker.service
OnFailure=outlet-ops-notify@%n.service

[Service]
Type=oneshot
ExecStart=/opt/outlet-ops/current/deploy/restore-drill.sh
ExecStartPost=/opt/outlet-ops/current/deploy/heartbeat.sh restore-drill
TimeoutStartSec=1800
Nice=10
