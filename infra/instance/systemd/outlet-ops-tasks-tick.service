[Unit]
Description=Outlet Ops tasks job: checklist instances, reminders and escalation
After=network-online.target docker.service

[Service]
Type=oneshot
User=outletops-wf
Group=outletops-wf
# Only the wf_executor password (ops.tasks_tick is granted to wf_executor only).
LoadCredential=db_wf_executor:/etc/outlet-ops/creds/wf_executor
ExecStart=/opt/outlet-ops/current/deploy/tasks-tick.sh
TimeoutStartSec=120
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
