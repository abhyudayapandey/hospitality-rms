[Unit]
Description=Outlet Ops workflow executor (one pass over wf.outbox)
After=network-online.target docker.service

[Service]
Type=oneshot
User=outletops-wf
Group=outletops-wf
# Only the wf_executor password.
LoadCredential=db_wf_executor:/etc/outlet-ops/creds/wf_executor
ExecStart=/opt/outlet-ops/current/deploy/wf-execute.sh
TimeoutStartSec=55
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
