[Unit]
Description=Outlet Ops nightly attendance exceptions and location purge
After=network-online.target docker.service

[Service]
Type=oneshot
User=outletops-wf
Group=outletops-wf
# Only the wf_executor password (hr.nightly_attendance is granted to wf_executor only).
LoadCredential=db_wf_executor:/etc/outlet-ops/creds/wf_executor
ExecStart=/opt/outlet-ops/current/deploy/attendance-nightly.sh
TimeoutStartSec=300
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
