[Unit]
Description=Outlet Ops pg_dump to S3
After=docker.service
# A failure emails the alert address and is shown in the console (ADR 171).
OnFailure=outlet-ops-notify@%n.service

[Service]
Type=oneshot
ExecStart=/opt/outlet-ops/current/deploy/pg-backup.sh
# + runs as root: records a good run (platform.job_ran) as the database superuser
ExecStartPost=+/opt/outlet-ops/current/deploy/heartbeat.sh pg-backup
