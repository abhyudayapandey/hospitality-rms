# Copy to .env and fill in. Never commit .env.
# Local values below match docker-compose.yml (local-only passwords).

# --- Database ---
# App runtime connects as app_rw (no BYPASSRLS, not table owner).
DATABASE_URL=postgres://app_rw:app_rw_local@localhost:5432/outlet_ops?sslmode=disable
# Migrations (dbmate) run as migrator.
MIGRATOR_DATABASE_URL=postgres://migrator:migrator_local@localhost:5432/outlet_ops?sslmode=disable
# Workflow executor (wf-execute) connects as wf_executor.
WF_EXECUTOR_DATABASE_URL=postgres://wf_executor:wf_executor_local@localhost:5432/outlet_ops?sslmode=disable
# Platform worker only (ADR 012): loads customer data, no DDL. Never given to the web app.
PLATFORM_LOADER_DATABASE_URL=postgres://platform_loader:platform_loader_local@localhost:5432/outlet_ops?sslmode=disable
# DB integration tests connect as app_rw against the local/CI Postgres.
TEST_DATABASE_URL=postgres://app_rw:app_rw_local@localhost:5432/outlet_ops?sslmode=disable
# Used by docker compose for the superuser.
POSTGRES_PASSWORD=postgres_local

# --- Auth ---
# Dev-only login and test request form; ignored by production builds, and a production
# build fails if this is true (ADR 004).
DEV_AUTH_STUB=true
# HMAC key for the session cookie, at least 32 characters. Local-only value below;
# deployed environments get theirs from SSM Parameter Store (docs/deploy.md).
SESSION_SECRET=local-dev-session-secret-change-me-0123456789
# Public base URL of the web app (Cognito redirect/logout URIs).
APP_URL=http://localhost:3000
# Cognito user pool + app client (public client, Hosted UI, PKCE). Leave empty to
# disable Cognito sign-in locally.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Hosted UI domain, e.g. outlet-ops.auth.ap-south-1.amazoncognito.com
COGNITO_DOMAIN=

# --- AWS ---
AWS_REGION=ap-south-1
# Private bucket for wastage photos (presigned upload/view URLs, ADR 006). Empty = photo
# capture is off (local dev). In production fetch-params.sh sets it from SSM; the web
# process signs with the instance role, so no AWS keys are ever configured.
PHOTO_BUCKET=

# --- AI ---
ANTHROPIC_API_KEY=
